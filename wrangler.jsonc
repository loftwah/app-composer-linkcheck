{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "composer-linkcheck",
  "account_id": "1003dc1d93af0ebea56b2f1252f89627",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "share.loftwah.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "limits": {
    "cpu_ms": 100
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "ratelimits": [
    {
      "name": "INSPECTION_LIMIT",
      "namespace_id": "2026101350",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
