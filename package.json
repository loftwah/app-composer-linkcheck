{
  "name": "@loftwah/composer-linkcheck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "pnpm source:write && wrangler dev --config wrangler.jsonc --env= --port 4330",
    "check": "pnpm check:types && pnpm lint && pnpm format:check && pnpm test",
    "test": "node scripts/identity.mjs && node --experimental-strip-types --test tests/*.test.mjs",
    "test:metadata": "node --experimental-strip-types --test tests/metadata.test.mjs",
    "test:fetch": "node --experimental-strip-types --test tests/fetch.test.mjs",
    "test:effect": "node --experimental-strip-types --test tests/batch.test.mjs tests/effect-runtime.test.mjs tests/effect-demo.test.mjs",
    "build": "pnpm check:types && wrangler deploy --config wrangler.jsonc --env= --dry-run --outdir dist",
    "deploy": "node scripts/deploy.mjs",
    "test:identity": "node --experimental-strip-types --test tests/identity.test.mjs",
    "test:diagnostics": "node --experimental-strip-types --test tests/diagnostics.test.mjs",
    "source:write": "node scripts/identity.mjs && node scripts/build-source.mjs --write",
    "check:types": "node scripts/identity.mjs && node scripts/build-source.mjs --check",
    "lint": "node scripts/identity.mjs && node scripts/build-source.mjs --lint",
    "format:check": "node scripts/format-source.mjs --check",
    "format": "node scripts/format-source.mjs --write"
  },
  "dependencies": {
    "effect": "4.0.4",
    "htmlparser2": "12.0.0",
    "image-size": "2.0.4"
  },
  "devDependencies": {
    "wrangler": "4.143.1",
    "typescript": "6.0.3",
    "@cloudflare/workers-types": "5.20260929.1",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
