{
  "name": "@loftwah/composer-linkcheck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "wrangler dev --port 4330",
    "check": "node scripts/identity.mjs && tsc --noEmit && node scripts/browser-assets.mjs --check",
    "test": "node scripts/identity.mjs && node --experimental-strip-types --test tests/*.test.mjs",
    "test:metadata": "node --experimental-strip-types --test tests/metadata.test.mjs",
    "test:fetch": "node --experimental-strip-types --test tests/fetch.test.mjs",
    "build": "node scripts/identity.mjs && node scripts/browser-assets.mjs --check && wrangler deploy --dry-run --outdir dist",
    "deploy": "node scripts/deploy.mjs",
    "test:identity": "node --experimental-strip-types --test tests/identity.test.mjs",
    "test:diagnostics": "node --experimental-strip-types --test tests/diagnostics.test.mjs"
  },
  "dependencies": {
    "effect": "4.0.4",
    "htmlparser2": "12.0.0",
    "image-size": "2.0.4"
  },
  "devDependencies": {
    "wrangler": "4.143.1",
    "typescript": "6.0.3",
    "@cloudflare/workers-types": "5.20260929.1"
  }
}
